{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Windharp",
  "version": "4.1.0",
  "identifier": "com.kevsketch.windharp",
  "build": {
    "beforeDevCommand": "pnpm dev:frontend",
    "beforeBuildCommand": "pnpm build:frontend",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/icon.icns",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Windharp — music player",
    "longDescription": "Windharp — a lightweight, fast unofficial YouTube Music client built with Tauri and Rust. Fork of pear-desktop (th-ch/youtube-music).",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
